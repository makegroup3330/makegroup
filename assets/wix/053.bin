.Qh0lWW{width:100%;height:100%;display:block}.Qh0lWW img{max-width:var(--wix-img-max-width,100%)}.Qh0lWW[data-animate-blur] img{filter:blur(9px);transition:filter .8s ease-in}.Qh0lWW[data-animate-blur] img[data-load-done]{filter:none}.sFiSiq{width:100%;height:100%;display:block}.ehSqxA{flex-direction:column;align-items:center;height:100%;display:flex}.ehSqxA .f1js_J{box-sizing:border-box;flex-grow:1;width:100%;height:calc(100% - 5px);padding:0 5px}.ehSqxA .f1js_J .KmIFOC{height:calc(100% - 5px)}.ehSqxA .AdtIWX{font:var(--fnt,var(--font_8));color:rgb(var(--txt,var(--color_15,color_15)));white-space:nowrap;transition:color .5s;display:inline-block;position:relative;top:-5px}.ehSqxA:hover .AdtIWX{color:rgb(var(--txth,var(--color_13,color_13)))}